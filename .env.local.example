# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Without these, the
# site still renders and plays music — it just won't show the live "online"
# count or join notifications.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — your deployed URL (e.g. https://pahadi-adda.vercel.app), used
# to build the absolute link in the social share card (og:image etc.).
# Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=
